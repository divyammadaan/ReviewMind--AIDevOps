# Copy this file to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored and must NEVER be committed.

# --- Groq (LLM provider). Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- GitHub (only needed to post comments on real PRs)
# Fine-grained PAT with: Pull requests = Read & Write, Contents = Read
GITHUB_TOKEN=
GITHUB_REPO=your-username/your-repo

# --- Execution mode
# mock  = no network, deterministic canned LLM output (safe for offline demo)
# live  = real Groq API calls
REVIEWMIND_LLM_MODE=mock

# --- AIDevOps self-healing (aidevops/): primary key, then two fallbacks, tried in this order
# GROQ_API_KEY above is the primary.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Models tried per key, in order (optional)
# GROQ_FIX_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# GITHUB_BASE_BRANCH=main
# GITHUB_SERVICE_PATH=aidevops/golden
