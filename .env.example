# Copy this file to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored and must NEVER be committed.

# --- Groq (LLM provider). Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- GitHub (only needed to post comments on real PRs)
# Fine-grained PAT with: Pull requests = Read & Write, Contents = Read
GITHUB_TOKEN=
GITHUB_REPO=your-username/your-repo

# --- Execution mode
# mock  = no network, deterministic canned LLM output (safe for offline demo)
# live  = real Groq API calls
REVIEWMIND_LLM_MODE=mock

# --- AIDevOps self-healing (aidevops/): primary key, then two fallbacks, tried in this order
# GROQ_API_KEY above is the primary.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Models tried per key, in order (optional)
# GROQ_FIX_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# GITHUB_BASE_BRANCH=main
# GITHUB_SERVICE_PATH=aidevops/golden
# VERIFY_TIMEOUT=14        # seconds a deployed patch gets to pass its health probe before it is rolled back
# OTEL_SDK_DISABLED=true   # turn OpenTelemetry off (set it on a service in docker-compose.yml)

# --- End-term features (all optional; the dashboard switches override these at runtime)
# WATCHDOG=off            # on: prepare a fix automatically when a service fails (a human still approves)
# AGENTIC=on              # off: use a single Fixer instead of Triage + Fixer + Reviewer
# CANARY=off              # on: try approved patches on a canary share of traffic first
# CANARY_PERCENT=30
# CANARY_OBSERVE=18       # seconds
# MOBILE_TOKEN=           # protects the phone app's API; generated and shown in the dashboard if empty
# VAPID_SUBJECT=mailto:you@example.com
# CONTAINER_SOCK=/var/run/docker.sock   # Podman: set by podman-up.ps1
